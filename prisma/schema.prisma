// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  ADMIN
  EDITOR
}

enum AuditTransaction {
  CREATE
  UPDATE
  DELETE
  VERIFY
  REJECT
  LOGIN
  LOGOUT
}

enum CampaignStatus {
  NOT_STARTED
  ACTIVE
  FINISHED
  INACTIVE
}

enum ProposalStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum GalleryType {
  IMAGE
  VIDEO
}

enum PaymentMethodType {
  BANK_TRANSFER
  QRIS
}

enum DonationStatus {
  PENDING
  ACCEPTED
  ACCEPTED_BY_REVISION
  REJECTED
}

enum NotificationType {
  NEW_DONATION
  SYSTEM
}

enum ContactType {
  WHATSAPP
  TELEGRAM
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String
  role     Role
  isActive Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  audits AuditLog[]

  @@map("users")
}

model SiteSetting {
  key   String @unique
  value String  @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("site_settings")
}

model AuditLog {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  transaction AuditTransaction

  entity   String
  entityId String?

  description String?

  metadata Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([transaction])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_log")
}

model Campaigns {
  id          String          @id @default(uuid())
  status      CampaignStatus  @default(ACTIVE)
  startAt     DateTime        @db.Timestamptz(3)
  endAt       DateTime        @db.Timestamptz(3)


  title       String
  description String

  targetDonationAmount   Float
  sponsorCount           Int

  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime?   @db.Timestamptz(3)

  homePageSection     HomePageSection?
  aboutUsSection      AboutUsSection?
  campaignProposals   CampaignProposal[]
  galleries           Gallery[]
  paymentMethods      PaymentMethod[]
  donations           Donation[]  
  contact             ContactList[]  
  
  @@map("campaigns")
}

model HomePageSection {
  id                      String   @id @default(uuid())
  
  campaignId              String    @unique
  campaign                Campaigns @relation( fields: [campaignId], references: [id], onDelete: Cascade )

  heroBgImage             String?
  heroTagline             String?
  heroTitle               String?
  heroDescription         String?   @db.Text

  whyHomeDescription      String?   @db.Text

  supportWorkTagline      String?
  supportWorkDescription	String?   @db.Text

  ctaSectionBgImage       String?
  ctaSectionTagline       String?
  ctaSectionTitle         String?
  ctaSectionSubtitle      String?   @db.Text

  createdAt               DateTime @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @db.Timestamptz(3)

  whySection              WhySection[]
  supportWorkSection      SupportWorkSection[]


  @@map("page_sections")
}

model WhySection {
  id                      String   @id @default(uuid())
  
  homePageSectionId           String
  homePageSection             HomePageSection @relation( fields: [homePageSectionId], references: [id], onDelete: Cascade )

  icon                    String?
  title                   String
  subTitle                String?  @db.Text

  createdAt               DateTime @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @db.Timestamptz(3)

  @@map("why_sections")
}

model SupportWorkSection {
  id                      String   @id @default(uuid())
  
  homePageSectionId           String
  homePageSection             HomePageSection @relation( fields: [homePageSectionId], references: [id], onDelete: Cascade )

  order                   Int
  icon                    String?
  title                   String
  description             String? @db.Text
  tagline                 String?

  focus                   String[]

  createdAt               DateTime @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @db.Timestamptz(3)

  @@unique([homePageSectionId, order])
  @@map("support_work_sections")
}

model AboutUsSection {
  id                      String   @id @default(uuid())
  
  campaignId              String    @unique
  campaign                Campaigns @relation( fields: [campaignId], references: [id], onDelete: Cascade )

  heroBgImage             String?
  heroTagline             String?
  heroTitle               String?
  heroDescription         String?   @db.Text

  vision                  String?   @db.Text
  mission                 String[]

  createdAt               DateTime @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @db.Timestamptz(3)

  CampaignTim             CampaignTim[]
  WorkStructureDivision   WorkStructureDivision[]

  @@map("about_us_sections")
}

model CampaignTim {
  id                      String   @id @default(uuid())
  aboutUsSectionId        String
  aboutUsSection          AboutUsSection @relation( fields: [aboutUsSectionId], references: [id], onDelete: Cascade )


  image                  String?
  name                   String
  position               String?

  instagram              String?
  linkedin               String?

  createdAt               DateTime @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @db.Timestamptz(3)

  @@map("campaign_tim")
}

model WorkStructureDivision {
  id                      String   @id @default(uuid())
  
  aboutUsSectionId        String
  aboutUsSection          AboutUsSection @relation( fields: [aboutUsSectionId], references: [id], onDelete: Cascade )

  divisionName            String
  divisionJobDescription  String   @db.Text

  createdAt               DateTime @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @db.Timestamptz(3)

  @@map("work_structure_divisions")
}

model CampaignProposal {
  id                      String   @id @default(uuid())
  
  campaignId              String
  campaign                Campaigns @relation( fields: [campaignId], references: [id], onDelete: Cascade )

  title                   String
  description             String
  proposalPdfUrl          String?
  status                  ProposalStatus @default(DRAFT)

  createdAt               DateTime @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @db.Timestamptz(3)

  @@map("campaign_proposals")
}

model Gallery {
  id                      String   @id @default(uuid())
  
  campaignId              String
  campaign                Campaigns @relation( fields: [campaignId], references: [id], onDelete: Cascade )

  galleryType             GalleryType @default(IMAGE)
  imageUrl                String
  videoUrl                String?
  title                   String?
  description             String?

  timeStamp               DateTime? @db.Timestamptz(3)

  createdAt               DateTime @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @db.Timestamptz(3)

  @@map("galleries")
}

model PaymentMethod {
  id                      String   @id @default(uuid())
  
  campaignId              String
  campaign                Campaigns @relation( fields: [campaignId], references: [id], onDelete: Cascade )

  type                    PaymentMethodType @default(BANK_TRANSFER)

  qrisImage               String?
  bankName                String?
  accountNumber           String?

  name                    String
  description             String?

  createdAt               DateTime @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @db.Timestamptz(3)

  @@map("payment_methods")
}

model Donation {
  id                      String   @id @default(uuid())
  
  campaignId              String
  campaign                Campaigns @relation( fields: [campaignId], references: [id], onDelete: Cascade )

  donorName               String    @default("Anonymous")
  amount                  Float
  acceptedAmount          Float?

  proofOfPaymentUrl       String?

  message                 String?    @db.Text
  reply                   String?    @db.Text

  status                  DonationStatus @default(PENDING)

  createdAt               DateTime @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @db.Timestamptz(3)

  @@map("donations")
}

model Notification {
  id          String           @id @default(uuid())
  title       String
  message     String           @db.Text
  type        NotificationType @default(NEW_DONATION)
  isRead      Boolean          @default(false)

  // Relasi Opsional ke Donation
  donationId  String?

  createdAt   DateTime         @default(now()) @db.Timestamptz(3)

  @@map("notifications")
}

model ContactList {
  id                      String    @id @default(uuid())
  campaignId              String
  campaign                Campaigns @relation( fields: [campaignId], references: [id], onDelete: Cascade )

  name                    String
  role                    String
  phone                   String

  type                    ContactType @default(WHATSAPP)

  createdAt               DateTime @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @db.Timestamptz(3)
}

model test {
  key       String    @id     @default(cuid())
  name      String
}